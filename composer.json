{
  "name": "dnurmanbetov/laravel",
  "description": "Base package for Laravel projects",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "dnurmanbetov\\laravel\\": "src/"
    }
  },
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3"
  },
  "extra": {
    "laravel": {
      "providers": [
        "dnurmanbetov\\laravel\\laravelServiceProvider"
      ]
    }
  }
}